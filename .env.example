APP_NAME="Nella & Vale"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PUBLIC_STORAGE_URL="${APP_URL}/storage"
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=preview@example.com
MAIL_FROM_NAME="Nella & Vale"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
FRONTEND_URL="${APP_URL}"
# Full origins, including scheme and optional port; separate multiple origins with commas.
FRONTEND_ORIGINS="${APP_URL}"
# Hosts and optional ports only (production example: elaf-store.vercel.app).
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000,127.0.0.1:8000
SESSION_COOKIE=nv_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_MERCHANT_ID=
PAYPAL_SANDBOX_WEBHOOK_ID=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_MERCHANT_ID=
PAYPAL_LIVE_WEBHOOK_ID=
PAYPAL_WEBHOOK_BASE_URL=http://localhost:8000
PAYPAL_RETURN_URL="${APP_URL}/api/paypal/return"
PAYPAL_CANCEL_URL="${APP_URL}/api/paypal/cancel"

# Shared only with the Next.js BFF for signed ingress client-IP rate limits.
BFF_RATE_SECRET=

# Gateways appear automatically only when the selected environment is complete.
# Set ENABLED=false to hide a configured gateway. Secrets belong only in Laravel.
STRIPE_ENABLED=true
STRIPE_MODE=sandbox
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_SANDBOX_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=

TRIPLEA_ENABLED=true
TRIPLEA_MODE=sandbox
TRIPLEA_SANDBOX_CLIENT_ID=
TRIPLEA_SANDBOX_CLIENT_SECRET=
TRIPLEA_SANDBOX_MERCHANT_KEY=
# Optional override, max 64 characters. By default Laravel derives a signing secret from APP_KEY.
TRIPLEA_SANDBOX_NOTIFY_SECRET=
TRIPLEA_LIVE_CLIENT_ID=
TRIPLEA_LIVE_CLIENT_SECRET=
TRIPLEA_LIVE_MERCHANT_KEY=
TRIPLEA_LIVE_NOTIFY_SECRET=

# Public storefront URL: Next.js forwards signed webhooks to Laravel.
# Stripe: configure a snapshot webhook for checkout.session.*, payment_intent.*,
# charge.refunded, charge.dispute.created, refund.created/updated/failed.
# Endpoint: ${PAYMENT_WEBHOOK_BASE_URL}/api/v1/webhooks/stripe/sandbox (or live).
# Triple-A notify_url and notify_secret are supplied automatically per payment/refund.
# Triple-A sandbox uses testBTC. Live currencies (including USDT) depend on merchant activation.
PAYMENT_WEBHOOK_BASE_URL="${APP_URL}"
PAYPAL_ENABLED=true
